<Window x:Class="Client.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Sign Up" Height="450" Width="800"
        FontSize="20"
        Style="{StaticResource DarkWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="loginStack" Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="380">

            <Grid x:Name="usernameStack" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Name="usernameLabel" Content="Username:"/>
                <TextBox x:Name="usernameInput" Grid.Column="1"/>
            </Grid>

            <Grid x:Name="passwordStack" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Name="passwordLabel" Content="Password:"/>
                <PasswordBox x:Name="passwordInput" Grid.Column="1"/>
            </Grid>

            <Grid x:Name="emailStack" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Name="emailLabel" Content="Email:"/>
                <TextBox x:Name="emailInput" Grid.Column="1"/>
            </Grid>

            <Grid x:Name="buttonsGrid" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="signupButton" Content="Sign Up" Margin="0,0,10,0" Click="signupButtonClicked"/>
                <Button x:Name="backToLoginButton" Content="Go Back To Log In Screen" Grid.Column="1" Click="backToLoginButtonClicked"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>