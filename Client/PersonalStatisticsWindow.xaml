<Window x:Class="Client.PersonalStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Personal Statistics" Height="350" Width="400"
        FontSize="20"
        Style="{StaticResource DarkWindow}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Personal Statistics" Grid.Row="0" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <Label Content="Average answer time: "></Label>
                    <Label Content="Correct answers: "></Label>
                    <Label Content="Total answers: "></Label>
                    <Label Content="Games played: "></Label>
                    <Label Content="High score: "></Label>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <Label x:Name="avgAnswerTimeLabel" Content="Loading "></Label>
                    <Label x:Name="correctAnswersLabel" Content="Loading "></Label>
                    <Label x:Name="totalAnswersLabel" Content="Loading "></Label>
                    <Label x:Name="numGamesLabel" Content="Loading "></Label>
                    <Label x:Name="highScoreLabel" Content="Loading "></Label>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
