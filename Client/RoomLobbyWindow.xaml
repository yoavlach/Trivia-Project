<Window x:Class="Client.RoomLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Room Lobby" Height="450" Width="800"
        FontSize="20"
        Style="{StaticResource DarkWindow}">
    <Grid>
        <StackPanel x:Name="roomLobbyStack" VerticalAlignment="Center" Width="500">
            <Label x:Name="roomNameLabel" Content="RoomName" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
            <ScrollViewer x:Name="playersScrollViewer" Height="300" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="playersPanel"/>
            </ScrollViewer>
            <Button x:Name="refreshButton" Content="Refresh" Width="120" Click="refreshButtonPressed"/>
        </StackPanel>
    </Grid>
</Window>