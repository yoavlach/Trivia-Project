<Window x:Class="Client.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Menu" Height="450" Width="800"
        FontSize="20"
        Style="{StaticResource DarkWindow}">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="menuLabel" Content="Menu" HorizontalAlignment="Center" FontWeight="Bold" FontSize="30"/>
            <Button x:Name="createRoomButton" Content="Create Room" Margin="0,10,0,5" Click="createRoomButtonPressed"/>
            <Button x:Name="joinRoomButton" Content="Join Room" Margin="0,5,0,5" Click="joinRoomButtonPressed"/>
            <Button x:Name="statisticsButton" Content="Statistics" Margin="0,5,0,5" Click="statisticsButtonPressed"/>
            <Button x:Name="exitButton" Content="Exit" Margin="0,5,0,0" Click="exitButtonPressed"/>
        </StackPanel>
    </Grid>
</Window>