<Window x:Class="Client.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="Statistics" Height="350" Width="400"
        FontSize="20"
        Style="{StaticResource DarkWindow}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Statistics" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="personalStatisticsButton" Content="Personal Statistics" Width="200" Margin="0,0,5,0" Click="personalStatisticsButtonPressed"></Button>
                <Button x:Name="highScoresButton" Content="High Scores" Width="150" Margin="5,0,0,0" Click="highScoresButtonPressed"></Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
