<Window x:Class="Client.HighScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="High Scores" Height="450" Width="800"
        FontSize="20"
        Style="{StaticResource DarkWindow}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Label Content="High Scores" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"></Label>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                    <Label x:Name="firstUsernameLabel" Content="username1"/>
                    <Label x:Name="secondUsernameLabel" Content="username2"/>
                    <Label x:Name="thirdUsernameLabel" Content="username3"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Label x:Name="firstUsernameScore" Content="highscore1"/>
                    <Label x:Name="secondUsernameScore" Content="highscore2"/>
                    <Label x:Name="thirdUsernameScore" Content="highscore3"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
